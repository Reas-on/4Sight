# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Backend database connection (native development)
DATABASE_URL=postgresql://4sight:4sight_dev_password@127.0.0.1:5433/4sight
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Docker Compose PostgreSQL service
POSTGRES_DB=4sight
POSTGRES_USER=4sight
POSTGRES_PASSWORD=4sight_dev_password
POSTGRES_PORT=5433
BACKEND_PORT=3001
