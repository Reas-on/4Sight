# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Backend database connection (native development)
DATABASE_URL=postgresql://4sight:4sight_dev_password@127.0.0.1:5433/4sight
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Docker Compose PostgreSQL service
POSTGRES_DB=4sight
POSTGRES_USER=4sight
POSTGRES_PASSWORD=4sight_dev_password
POSTGRES_PORT=5433
BACKEND_PORT=3001

# Server-side AI configuration. Select one provider explicitly; no fixture fallback.
# Leave AI_PROVIDER empty when not using AI. Configure only the selected model.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Per-attempt timeout; retries are additional attempts (0-3), bounded by a total budget.
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# Simulation API. Fixture mode is an explicit local demo, never an AI fallback.
SIMULATION_ENABLED=true
SIMULATION_MODE=ai
# Required for non-loopback HOST (including the Compose backend); use a random 32+ character token.
SIMULATION_ACCESS_TOKEN=
# Exact public browser origin for the standard local Vite frontend.
# localhost and 127.0.0.1 are different origins; use the one opened in the browser.
# Leave empty only to use the backend's same-origin HTTP Host validation.
SIMULATION_ALLOWED_ORIGIN=http://localhost:5173

# Same-origin Vite development proxy (server-side only; never prefix secrets with VITE_).
BACKEND_API_TARGET=http://127.0.0.1:3001
# The proxy preserves the browser Host/Origin; do not rewrite Origin to bypass CSRF.
